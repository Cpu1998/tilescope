{
  // Vue 3 + Vite 前端工程的 TS 配置。
  // 仅覆盖前端源码：worker/、db/、examples/ 属于 vinext 时代的后端脚手架，
  // 已不在 Vue 构建链内，故不纳入 include，避免引用已移除依赖而报错。
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "shared/**/*.js",
    "build/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "github-pages"]
}
